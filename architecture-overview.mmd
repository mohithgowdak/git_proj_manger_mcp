%% Simplified Overview Architecture Diagram

graph TB
    subgraph "Client Applications"
        C1["Cursor IDE"]
        C2["Claude Desktop"]
        C3["VS Code"]
    end

    subgraph "MCP GitHub Project Manager Server"
        subgraph "Entry Point"
            MCP["MCP Server<br/>JSON-RPC via stdio"]
        end
        
        subgraph "Tool Execution"
            TR["Tool Registry<br/>47+ Tools"]
            TH["Tool Handlers<br/>& Validators"]
        end
        
        subgraph "Business Logic"
            PMS["Project Management<br/>Service"]
        end
        
        subgraph "Data Access"
            RF["Repository Factory"]
            PR["Project Repo"]
            IR["Issue Repo"]
            MR["Milestone Repo"]
            SR["Sprint Repo"]
        end
        
        subgraph "Infrastructure"
            GQL["GraphQL Client"]
            PG["PyGithub Client"]
            EC["Error Handler"]
            RC["Resource Cache<br/>60-80% Hit Rate"]
        end
    end

    subgraph "External Services"
        GH["GitHub API<br/>(GraphQL + REST)"]
    end

    C1 --> MCP
    C2 --> MCP
    C3 --> MCP
    
    MCP --> TR

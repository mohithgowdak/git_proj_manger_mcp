    RF --> SR
    
    PR --> GQL
    IR --> GQL
    MR --> GQL
    SR --> GQL
    
    PR --> PG
    IR --> PG
    
    GQL --> EC
    PG --> EC
    EC --> GH
    
    PMS --> RC
    
    style MCP fill:#9c27b0,color:#fff
    style TR fill:#ff9800,color:#fff
